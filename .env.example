# --------------------------------------------------------------
# 1. Database Configuration
# --------------------------------------------------------------
# Option A: Remote / Production MySQL (e.g. Hostinger, AWS RDS)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Option B: PostgreSQL Database (Supabase, Neon, Railway)
DATABASE_URL=

# (If neither DB_HOST nor DATABASE_URL is set, Cars9 falls back to local sqlite.db)

# --------------------------------------------------------------
# 2. JWT & Security Configuration
# --------------------------------------------------------------
JWT_SECRET=your-random-32-char-secret-key-here
ADMIN_PASSWORD=cars9pass
STAFF_PASSWORD=cars9staff

# --------------------------------------------------------------
# 3. Telegram Distributed Image CDN (Media Vault)
# --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --------------------------------------------------------------
# 4. Server Configuration
# --------------------------------------------------------------
PORT=3000
